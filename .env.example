# Supabase — sin esto la app corre igual, leyendo el contenido de data/dist/*.json
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # llave pública (antes "anon"): viaja al navegador
SUPABASE_SECRET_KEY=                       # llave secreta (antes "service_role"): SOLO servidor

# Sólo para los scripts de carga por psql y de generación de lecturas
DATABASE_URL=
ANTHROPIC_API_KEY=

# Dominio público (para Open Graph, sitemap y robots). Railway: NEXT_PUBLIC_SITIO=https://…
NEXT_PUBLIC_SITIO=

# Cobro (Paddle). Sin estas, la pantalla de suscripción avisa de que el pago
# aún no está abierto y la app sigue funcionando entera.
# Ojo: NADA de NEXT_PUBLIC_ aquí — el Dockerfile no pasa variables al build,
# así que se leen en el servidor y bajan como props.
PADDLE_ENTORNO=sandbox        # sandbox mientras se prueba, production al abrir
PADDLE_TOKEN=                 # token de cliente (test_… o live_…), va al navegador
PADDLE_PRECIO=                # id del precio mensual (pri_…)
PADDLE_API_KEY=               # llave de servidor (pdl_…), SOLO servidor
PADDLE_WEBHOOK_SECRET=        # secreto del destino de notificaciones (pdl_ntfset_…)
